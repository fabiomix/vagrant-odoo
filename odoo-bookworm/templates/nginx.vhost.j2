server {
  port_in_redirect off;
  listen 80;
  server_name odoo.dev2024.local;
  access_log "/var/log/nginx/odoo.access.log";
  error_log "/var/log/nginx/odoo.error.log";
  client_max_body_size 51200m;
  client_header_buffer_size 64k;
  large_client_header_buffers 4 1m;

  location / {
    proxy_pass http://127.0.0.1:4001;
    proxy_redirect off;
    proxy_set_header                Host            $host;
    proxy_set_header                X-Real-IP       $remote_addr;
    proxy_set_header                X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 300;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
  }

  location /longpolling {
    proxy_pass http://127.0.0.1:5001;
    proxy_redirect off;
    proxy_set_header                Host            $host;
    proxy_set_header                X-Real-IP       $remote_addr;
    proxy_set_header                X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 600;
    proxy_read_timeout 600;
    proxy_send_timeout 600;
  }

  # common gzip
  gzip_types text/css text/less text/plain text/xml application/xml application/json application/javascript application/x-javascript image/svg+xml;
  gzip on;
}
